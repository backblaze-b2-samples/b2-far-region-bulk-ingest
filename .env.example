# Backblaze B2 credentials. Copy this file to .env and fill in your values.
# .env is gitignored; never commit it.
B2_APPLICATION_KEY_ID=your-application-key-id
B2_APPLICATION_KEY=your-application-key
B2_BUCKET_NAME=your-bucket-name
# Region slug from your bucket's S3 endpoint, for example us-west-004.
B2_REGION=your-region

# Optional: base URL for public object links (public buckets only).
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.your-region.backblazeb2.com

# Optional, make demo only: run nonce that scopes every demo write and listing to
# sample-lite/b2-far-region-bulk-ingest/<nonce>/. A fresh one is generated when unset.
# LITE_NONCE=

# Optional, make demo only: "default" (185 files, 3 sites, 4 batches) or "large" (thousands of files, a few GB).
# Command-line SCALE wins over .env, then the caller's environment; unset or empty uses "default".
# SCALE=default
